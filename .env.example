# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-secret

# Direct OpenAI-compatible endpoint (recommended for BYOK).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Vercel AI Gateway fallback when OPENAI_API_KEY is empty.
AI_GATEWAY_API_KEY=

# Optional multiple OpenAI-compatible providers. Keep keys server-side only.
# Model ids use the provider prefix, e.g. groq/llama-3.3-70b-versatile.
AI_PROVIDER_CONFIG_JSON={"groq":{"apiKey":"gsk_replace_me","baseURL":"https://api.groq.com/openai/v1"},"openrouter":{"apiKey":"sk-or-replace_me","baseURL":"https://openrouter.ai/api/v1"}}

# Optional model catalog. The first model becomes the default.
AI_MODELS_JSON=[{"id":"openai/gpt-4o-mini","name":"GPT-4o mini","provider":"openai","description":"Fast general-purpose model"},{"id":"groq/llama-3.3-70b-versatile","name":"Llama 3.3 70B","provider":"groq","description":"Fast open model"}]
AI_TITLE_MODEL=openai/gpt-4o-mini

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Set to 1 only for the public demo mode.
IS_DEMO=0
